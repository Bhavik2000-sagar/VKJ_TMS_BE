generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TaskActivityType {
  COMMENT
  STATUS_CHANGE
  TIME_LOG
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  REVIEW_REQUIRED
  MENTION
  MEETING_INVITE
  SYSTEM
}

enum TenantStatus {
  INVITED
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations  TenantInvitation[]
  users        User[]
  roles        Role[]
  branches     Branch[]
  departments  Department[]
  taskStatuses TaskStatus[]
  tasks        Task[]
  meetings     Meeting[]
  templates    Template[]
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  users       User[]
  tasks       Task[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  users  User[]
  tasks  Task[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([branchId])
}

model TenantInvitation {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([tenantId, email])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  roleId       String
  managerId    String?
  branchId     String?
  departmentId String?
  employeeCode String?
  phone        String?
  birthDate    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role     Role    @relation(fields: [roleId], references: [id])
  manager  User?   @relation("Hierarchy", fields: [managerId], references: [id])
  reports  User[]  @relation("Hierarchy")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  tasksAssigned Task[] @relation("TaskAssigned")
  tasksCreated  Task[] @relation("TaskCreated")
  tasksReview   Task[] @relation("TaskReviewer")
  tasksSupport  Task[] @relation("TaskSupporter")
  activities    TaskActivity[]
  checklistChecks TaskChecklistItem[] @relation("ChecklistCheckedBy")
  meetingsCreated Meeting[] @relation("MeetingCreator")
  meetingAttendees MeetingAttendee[]
  notifications Notification[]
  userPermissions UserPermission[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@index([managerId])
  @@index([branchId])
  @@index([departmentId])
  @@unique([tenantId, employeeCode])
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String?
  code      String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
}

model Permission {
  id          String @id @default(cuid())
  action      String @unique
  module      String
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model TaskStatus {
  id         String   @id @default(cuid())
  tenantId   String
  code       String
  label      String
  sortOrder  Int      @default(0)
  isTerminal Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([tenantId, code])
}

model Task {
  id               String    @id @default(cuid())
  tenantId         String
  title            String
  description      String?   @db.Text
  statusId         String
  priority         String    @default("MEDIUM")
  assignedToId     String?
  reviewerId       String?
  supporterId      String?
  createdById      String
  branchId         String?
  departmentId     String?
  startDate        DateTime?
  dueDate          DateTime?
  estimatedMinutes Int?
  acceptedAt       DateTime?
  startedAt        DateTime?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  closedAt         DateTime?
  taskType         String    @default("GENERAL")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status      TaskStatus @relation(fields: [statusId], references: [id])
  assignedTo  User?      @relation("TaskAssigned", fields: [assignedToId], references: [id])
  reviewer    User?      @relation("TaskReviewer", fields: [reviewerId], references: [id])
  supporter   User?      @relation("TaskSupporter", fields: [supporterId], references: [id])
  createdBy   User       @relation("TaskCreated", fields: [createdById], references: [id])
  branch      Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  activities  TaskActivity[]
  checklistItems TaskChecklistItem[]
  attachments Attachment[]
  outcomes    MeetingOutcome[]

  @@index([tenantId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([branchId])
  @@index([departmentId])
}

model TaskChecklistItem {
  id          String   @id @default(cuid())
  taskId      String
  text        String   @db.Text
  sortOrder   Int      @default(0)
  mandatory   Boolean  @default(false)
  isChecked   Boolean  @default(false)
  checkedAt   DateTime?
  checkedById String?
  remarks     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checkedBy User? @relation("ChecklistCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([taskId])
  @@index([checkedById])
}

model TaskActivity {
  id        String           @id @default(cuid())
  taskId    String
  userId    String
  type      TaskActivityType
  message   String?          @db.Text
  metadata  Json?
  createdAt DateTime         @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  checklistItemId String?
  fileUrl   String
  fileName  String?
  mimeType  String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checklistItem TaskChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
}

model Meeting {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  agenda      String?  @db.Text
  datetime    DateTime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("MeetingCreator", fields: [createdById], references: [id])
  attendees MeetingAttendee[]
  outcomes  MeetingOutcome[]

  @@index([tenantId])
}

model MeetingAttendee {
  meetingId String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

model MeetingOutcome {
  id          String   @id @default(cuid())
  meetingId   String
  taskId      String?
  outcomeText String   @db.Text
  createdAt   DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id])

  @@index([meetingId])
}

model Template {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  department String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ChecklistItem[]

  @@index([tenantId])
}

model ChecklistItem {
  id         String  @id @default(cuid())
  templateId String
  text       String
  mandatory  Boolean @default(false)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  taskId    String?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
